
# ── 1. 单独回转 30°（顺时针 +0.5236 rad）──
ros2 topic pub -1 /v15/cmd/joint_states sensor_msgs/msg/JointState \
  "{header: {frame_id: base_link},
    name: ['swing_joint','boom_joint','arm_joint','bucket_joint'],
    position: [0.5236, 0.0873, 1.0472, 0.1745]}"

